# Copy to .env and fill in. Never commit .env.
API_URL=https://qnupoplh25.execute-api.eu-north-1.amazonaws.com/develop
# Frontend URL for the UI test (CloudFront domain of the deployed app)
UI_URL=https://your-cloudfront-domain.cloudfront.net
# Optional: use an existing customer as the Owner. If empty, a new customer is registered on every run.
OWNER_EMAIL=
OWNER_PASSWORD=
# Optional: pin the location. If empty, the first location returned by GET /locations is used.
LOCATION_ID=
